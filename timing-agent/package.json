{
  "name": "screenlock-agent",
  "version": "1.0.0",
  "description": "ScreenLock — Screen-off detection and attendance tracking agent for Sangria Edutainment",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev":   "electron . --dev",
    "build": "electron-builder --win portable --x64"
  },
  "build": {
    "appId":       "com.sangria.screenlock",
    "productName": "ScreenLock",
    "win": {
      "target": "nsis",
      "icon":   "assets/tray-icon.ico"
    },
    "nsis": {
      "oneClick":         false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "**/*",
      "!node_modules/.cache"
    ],
    "extraResources": [
      { "from": "epip-timing.config.json", "to": "epip-timing.config.json" }
    ],
    "portable": {
      "artifactName": "ScreenLock-${version}.exe"
    }
  },
  "dependencies": {
    "axios":          "^1.6.8",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron":         "^29.1.0",
    "electron-builder": "^24.9.1"
  },
  "author": "Sangria Edutainment Pvt Ltd",
  "license": "MIT"
}
