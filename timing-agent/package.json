{
  "name": "screen-lock-tracker",
  "version": "5.0.0",
  "description": "Screen Lock Tracker — attendance break tracking for Sangria Edutainment",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev":   "electron . --dev",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId":       "com.sangria.screen-lock-tracker",
    "productName": "Screen Lock Tracker",
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "ScreenLockTracker-${version}-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Screen Lock Tracker"
    },
    "portable": {
      "artifactName": "ScreenLockTracker-${version}-portable.exe"
    },
    "protocols": [
      {
        "name": "Screen Lock Tracker",
        "schemes": ["epip-timing"]
      }
    ],
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!dist"
    ],
    "extraResources": [
      { "from": "epip-timing.config.json", "to": "epip-timing.config.json" }
    ]
  },
  "dependencies": {
    "axios":          "1.6.8",
    "electron-store": "8.1.0"
  },
  "devDependencies": {
    "electron":         "29.4.6",
    "electron-builder": "24.13.3"
  },
  "author": "Sangria Edutainment Pvt Ltd",
  "license": "MIT"
}
