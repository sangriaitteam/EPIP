{
  "name": "epip-backend",
  "version": "1.0.0",
  "description": "EPIP Employee Performance Intelligence Platform - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start":      "node src/server.js",
    "dev":        "nodemon src/server.js",
    "migrate":    "node migrations/run.js",
    "seed":       "node seeders/run.js",
    "migrate:fresh": "node migrations/run.js --fresh",
    "test":       "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "7.4.0",
    "express-validator": "7.2.0",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "nodemailer": "6.9.14",
    "pg": "8.12.0",
    "uuid": "10.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "jest": "^30.5.1",
    "nodemon": "3.1.4",
    "supertest": "^7.2.2"
  }
}
