# ─────────────────────────────────────────────────────────────
#  EPIP Backend — Environment Variables Template
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to git — only commit .env.example
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Backend public URL (used for file URL generation) ─────────
BACKEND_URL=https://your-domain.com

# ── PostgreSQL ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=epip_db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_strong_password_here

# ── JWT ───────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_64_byte_random_hex_string
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
CLIENT_URL=https://your-frontend-domain.com

# ── Email (Nodemailer / Gmail SMTP) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# ── Storage ───────────────────────────────────────────────────
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# ── Screenshot Agent ─────────────────────────────────────────
SCREENSHOT_INTERVAL_MINUTES=10

# ── Super Admin ───────────────────────────────────────────────
# Only these emails can access Super Admin setup via OTP (max 2)
SUPERADMIN_EMAILS=admin@yourcompany.com
