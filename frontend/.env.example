# ─────────────────────────────────────────────────────────────────────────────
#  EPIP Frontend — Environment Variables Template
#  Copy this to .env (local) or .env.production (deploy)
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL
# Local development:
VITE_API_URL=http://localhost:5000/api

# Production (nginx same server):
# VITE_API_URL=https://your-domain.com/api

# Production (separate backend server):
# VITE_API_URL=https://api.your-domain.com

VITE_APP_NAME=EPIP
VITE_APP_VERSION=1.0.0
