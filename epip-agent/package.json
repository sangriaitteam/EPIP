{
  "name": "sangria-agent",
  "version": "1.0.0",
  "description": "Sangria Agent — Screen monitoring and attendance tracking for Sangria Edutainment",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win portable --x64",
    "build:nsis": "electron-builder --win nsis --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.sangria.agent",
    "productName": "Sangria Agent",
    "copyright": "Copyright © 2026 Sangria Edutainment Pvt Ltd",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "capture.js",
      "scheduler.js",
      "auth.js",
      "config.js",
      "renderer/**/*",
      "assets/**/*",
      "sangria-agent.config.json",
      "epip-agent.config.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "Sangria-Agent-${version}.exe"
    }
  },
  "dependencies": {
    "axios": "1.7.9",
    "electron-store": "8.2.0",
    "form-data": "4.0.1"
  },
  "devDependencies": {
    "electron": "32.2.7",
    "electron-builder": "24.13.3"
  },
  "author": "Sangria Edutainment Pvt Ltd",
  "license": "MIT"
}
