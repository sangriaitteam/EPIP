{
  "name": "sangria-screenshot",
  "version": "3.0.0",
  "description": "Sangria Screenshot Tool — background screenshot capture for Sangria Edutainment",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev":   "electron . --dev",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId":       "com.sangria.screenshot",
    "productName": "Sangria Screenshot",
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "protocols": [
      { "name": "Sangria Screenshot", "schemes": ["epip-screenshot"] }
    ],
    "files": [ "**/*", "!node_modules/.cache", "!dist" ],
    "extraResources": [
      { "from": "sangria-screenshot.config.json", "to": "sangria-screenshot.config.json" }
    ],
    "portable": {
      "artifactName": "Sangria-Screenshot-${version}-portable.exe"
    }
  },
  "dependencies": {
    "axios":          "1.6.8",
    "electron-store": "8.1.0",
    "form-data":      "4.0.0"
  },
  "devDependencies": {
    "electron":         "29.4.6",
    "electron-builder": "24.13.3"
  },
  "author": "Sangria Edutainment Pvt Ltd",
  "license": "MIT"
}
